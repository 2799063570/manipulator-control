<?xml version="1.0"?>
<package format="3">
  <name>wheeltec_base_driver</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Jazzy serial driver for Wheeltec mobile bases. It directly bridges
    cmd_vel to the base controller and publishes odometry, IMU, voltage and TF.
  </description>
  <maintainer email="todo@example.com">Manipulator-control maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
